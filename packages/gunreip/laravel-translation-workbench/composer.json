{
    "name": "gunreip/laravel-translation-workbench",
    "description": "Laravel translation discovery, review, and export workbench.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Gunreip\\TranslationWorkbench\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gunreip\\TranslationWorkbench\\TranslationWorkbenchServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0",
        "livewire/livewire": "^3.0|^4.0"
    }
}
