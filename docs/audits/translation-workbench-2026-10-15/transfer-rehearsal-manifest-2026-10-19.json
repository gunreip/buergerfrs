        "counts": {
          "active_findings": {
            "sql": "SELECT count(*) FROM translation_workbench_findings WHERE status='active'",
            "count": 18870
          },
          "active_links_to_obsolete_findings": {
            "sql": "SELECT count(*) FROM translation_workbench_key_findings l JOIN translation_workbench_findings f ON f.id=l.finding_id WHERE l.status='active' AND f.status='obsolete'",
            "count": 12
          },
          "multiple_active_named_key_ids": {
            "sql": "SELECT count(*) FROM (SELECT f.id FROM translation_workbench_findings f JOIN translation_workbench_key_findings l ON l.finding_id=f.id AND l.status='active' JOIN translation_workbench_keys k ON k.id=l.key_id AND k.status<>'obsolete' WHERE f.status='active' AND nullif(k.translation_key,'') IS NOT NULL GROUP BY f.id HAVING count(DISTINCT k.id)>1) s",
            "count": 27
          }
        }
      },
      "proposal": "Resolve exact affected IDs in the fresh copy; aggregate counts are not per-record repair instructions.",
