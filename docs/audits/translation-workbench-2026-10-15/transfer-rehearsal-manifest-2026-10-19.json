    },
    {
      "id": "restore_verified",
      "status": "not_completed",
      "requirement": "Restore that backup into a new isolated PostgreSQL cluster and prove row counts and value hashes."
    },
    {
      "id": "evidence_importer",
      "status": "not_completed",
      "requirement": "Implement copy-only evidence staging with explicit legacy-to-new ID mapping and loss accounting."
    },
    {
      "id": "fresh_capture",
      "status": "not_completed",
      "requirement": "Exercise actual scanner capture on the copied source; fixture capture is not a scanner replacement."
    },
    {
      "id": "unresolved_quarantine",
      "status": "not_completed",
      "requirement": "Keep undecided evidence separate from active assignments, approvals and publication."
    },
    {
      "id": "workflow_replay",
      "status": "not_completed",
      "requirement": "Test first/repeated scan, move, removal, copied/handmade, shared candidates, approvals and interrupted writes on the copy."
    },
    {
      "id": "comparison_report",
      "status": "not_completed",
      "requirement": "Prove no unique text lost, no obsolete finding reactivated, no old history replayed into the new timeline."
    }
